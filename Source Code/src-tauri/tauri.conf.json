{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Squish",
  "version": "1.0.1",
  "identifier": "dev.sajjad.squish",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Squish",
        "width": 980,
        "height": 700,
        "minWidth": 860,
        "minHeight": 600,
        "center": true,
        "decorations": false,
        "transparent": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "resources": {
      "binaries/ffmpeg.exe": "./",
      "binaries/WebView2Loader.dll": "./"
    },
    "windows": {
      "nsis": {
        "languages": ["English"],
        "displayLanguageSelector": false
      }
    }
  }
}
